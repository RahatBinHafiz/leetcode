class Solution {
public:
    int countServers(vector<vector<int>>& grid) {
        int ans = 0;
        int row = grid.size();
        int col = grid[0].size();
        vector<int>rowvec(row), colvec(col);
        for(int i = 0; i<row ; i++)
        {
            for(int j = 0; j<col; j++)
            {
                rowvec[i]+=grid[i][j];
                colvec[j]+=grid[i][j];
            }
        }

        for(int i = 0; i<row ; i++)
        {
            for(int j = 0; j<col; j++)
            {
                if(grid[i][j]==1)
                {
                   if(rowvec[i]>1 ||  colvec[j] >1) ans++;
                }
            }
        }

        return ans;

    }
};
