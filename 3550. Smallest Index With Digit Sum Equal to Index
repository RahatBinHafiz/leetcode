class Solution {
public:
    int smallestIndex(vector<int>& nums) {
        int ans = -1;
        int n = nums.size();
        for(int i = 0; i <n; i++ )
        {
           int sum = 0;
           int a = nums[i];
           while(a)
           {
             sum+=(a%10);
             a/=10;
           }   
           if(sum == i)
           {
            ans = i; break;
           }
        }
        return ans;
    }
};
